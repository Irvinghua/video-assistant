{
  "name": "video-assistant",
  "displayName": "Video assistant",
  "version": "0.0.1",
  "description": "A Chrome extension that summarizes video content and analyzes comments on Bilibili and YouTube",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "@types/uuid": "^11.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.563.0",
    "markmap-common": "^0.18.9",
    "markmap-lib": "^0.18.12",
    "markmap-toolbar": "^0.18.12",
    "markmap-view": "^0.18.12",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/d3": "^7.4.3",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "prettier": "3.2.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.3.3",
    "vitest": "^4.1.8"
  },
  "manifest": {
    "permissions": [
      "storage",
      "cookies",
      "scripting",
      "clipboardWrite"
    ],
    "host_permissions": [
      "https://*/*"
    ]
  }
}
